# ============================================
# 🧠 Aplikasi Prediksi Kebutuhan Bahan Baku (ARIMA)
# .gitignore untuk backend (FastAPI) dan frontend (React)
# ============================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
.env/
.venv/
env/
ENV/

# Jupyter / Temp
.ipynb_checkpoints/
*.ipynb
*.pkl
*.db
*.sqlite3

# Logs
*.log
*.out
*.err

# --- FastAPI ---
*.pid
*.pyproj
*.coverage
.coverage.*
.pytest_cache/
cache/
.mypy_cache/
.dmypy.json
.pyre/
htmlcov/

# --- Data files ---
*.csv
*.xlsx
*.xls
*.zip
*.tar
*.gz
*.pdf
*.bak
*.tmp
*.swp
*.swo

# --- Node / React Frontend ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# --- Editor / OS files ---
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# --- System ---
*.lock
*.pid
*.seed
*.orig

# --- Deployment ---
# (ignore docker-compose volumes and artifacts)
docker-compose.override.yml
*.log
*.bak
*.env
*.ini

# --- Backups ---
*.bak
*.backup
*.old

# --- Archive / Media ---
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.avi
*.mkv
*.svg

# --- Custom Project Artifacts ---
# temporary upload folders or exports
uploads/
export/
exports/
results/
temp/
tmp/
__temp__/
__export__/

# --- JetBrains / VSCode folders ---
.idea/
.vscode/
